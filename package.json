    "earcut": "^3.2.3",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "perfect-freehand": "^1.2.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "6.0.1",
    "vtracer-webapp": "0.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
