{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchaeoCAD",
  "version": "0.1.0",
  "identifier": "com.jjmartinezgarcia.archaeocad",
  "build": {
    "beforeDevCommand": "pnpm run dev:github",
    "beforeBuildCommand": "pnpm run build:github",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../github-dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArchaeoCAD",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "category": "GraphicsAndPhotography",
    "shortDescription": "Visor, editor y vectorizador de planos arqueológicos",
    "longDescription": "ArchaeoCAD convierte, edita y organiza planos arqueológicos en el dispositivo.",
    "copyright": "Copyright © José Javier Martínez García",
    "icon": [
      "../public/favicon.svg",
      "../public/icon-192.png",
      "../public/icon-512.png",
      "../public/icon-maskable-512.png"
    ]
  }
}
